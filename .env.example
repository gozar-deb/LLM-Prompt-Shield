# Copy this file to `.env` and fill in real values. Every variable here has
# a sane default in app/config.py — you only need to set what you want to
# change. See SETUP.md for scenario-specific walkthroughs.

# ---------------------------------------------------------------- #
# Service identity
# ---------------------------------------------------------------- #
SERVICE_NAME=llm-prompt-shield
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------- #
# Client-facing auth — keys YOUR clients must send to reach the shield.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------- #
PROXY_API_KEYS=change-me-to-a-real-random-key
REQUIRE_PROXY_AUTH=true

# ---------------------------------------------------------------- #
# Upstream LLM provider
#   openai_compatible -> OpenAI itself, vLLM (--api-key mode), Ollama /v1
#   anthropic          -> native Anthropic Messages API (translated)
# ---------------------------------------------------------------- #
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=https://api.openai.com
UPSTREAM_API_KEY=sk-your-real-upstream-key-here
UPSTREAM_TIMEOUT_SECONDS=60
UPSTREAM_ANTHROPIC_VERSION=2023-06-01

# ---------------------------------------------------------------- #
# Layer 1 — deterministic scanner
# ---------------------------------------------------------------- #
ENABLE_SECRET_REDACTION=true
ENABLE_PII_REDACTION=true
ENABLE_ANTI_EVASION_DECODING=true
BLOCK_ON_PII=false
BLOCK_ON_SECRET=false

# ---------------------------------------------------------------- #
# Layer 2 — ML / heuristic injection classifier
# ---------------------------------------------------------------- #
INJECTION_SCORE_THRESHOLD=0.70
ONNX_MODEL_PATH=app/models/prompt_guard_quant.onnx
ONNX_TOKENIZER_PATH=app/models/tokenizer
CLASSIFIER_BACKEND=auto

# ---------------------------------------------------------------- #
# Layer 3 — routing / resilience
# ---------------------------------------------------------------- #
MAX_RETRIES=1
CONNECT_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------- #
# Layer 4 — output DLP / canary
# ---------------------------------------------------------------- #
ENABLE_CANARY=true
ENABLE_OUTPUT_SECRET_SCAN=true
STRICT_STREAMING_DLP=true
STREAMING_DLP_BUFFER_CHARS=64

# ---------------------------------------------------------------- #
# Rate limiting
# ---------------------------------------------------------------- #
ENABLE_RATE_LIMIT=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---------------------------------------------------------------- #
# Audit logging
# ---------------------------------------------------------------- #
AUDIT_LOG_PATH=logs/audit.jsonl
AUDIT_LOG_PROMPT_PREVIEW_CHARS=120

# ---------------------------------------------------------------- #
# CORS
# ---------------------------------------------------------------- #
CORS_ALLOW_ORIGINS=*
